{
  "name": "md2mp",
  "version": "0.2.2",
  "description": "Markdown → 微信公众号 HTML，本地运行、模板 ZIP 分发的 CLI 工具",
  "license": "MIT",
  "author": "simonkuang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonkuang/md2mp.git"
  },
  "type": "module",
  "bin": {
    "md2mp": "./dist/md2mp.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
